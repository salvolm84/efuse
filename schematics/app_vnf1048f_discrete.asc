TEXT 48 -64 Left 2 ;VNF1048F behavioral - discrete 48 V application (DS13084 Fig. 16 + gate slew network)
TEXT 48 -24 Left 1 ;0.5 ms ON (10 A) | 5 ms overload +20 A -> I2t trip after tNOM/16 = 62.5 ms | 75 ms overload removed | 80 ms CLR -> restart
TEXT 48 992 Left 2 !.include ../models/VNF1048F_beh.lib
TEXT 48 1024 Left 2 !.model SOVL SW(Ron=2m Roff=1Meg Vt=0.5 Vh=-0.2)
TEXT 48 1056 Left 2 !.tran 0 100m 0 2u
TEXT 48 1088 Left 2 !.options plotwinsize=0
TEXT 704 992 Left 1 !.meas tran t_fuse find time when V(u1:fusel)=0.5 rise=1
TEXT 704 1016 Left 1 !.meas tran dt_fuse param t_fuse-5m
TEXT 704 1040 Left 1 !.meas tran iovl avg -I(Lh) from 20m to 30m
TEXT 704 1064 Left 1 !.meas tran vout_end avg V(out) from 95m to 100m
TEXT 704 1088 Left 1 !.save V(vbat) V(drn) V(out) V(load) V(hsg) V(g) V(cp) V(diag) V(cs) I(Lh) V(u1:fusel) V(u1:fd) V(u1:gcmd) V(u1:xa)
